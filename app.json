{
  "expo": {
    "name": "LinkShot",
    "slug": "linkshot-app",
    "scheme": "linkshot-app",
    "version": "1.0.0",
    "icon": "./src/assets/icon.png",
    "entryPoint": "./node_modules/expo-router/entry",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vvt.linkshot"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.vvt.linkshot"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.622990597633-8r2qreb64fmnj2dpk71ekockbdbaqvuh"
        }
      ]
    ]
  }
}